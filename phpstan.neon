# Includes resolve relative to this file, so the stub OM path stays correct both
# for local `composer phpstan` and when CI merges/runs against the Mautic root.

includes:
    - phpstan/doctrine-parameters.php

parameters:
    level: 6
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 1000.0

    bootstrapFiles:
        - phpstan-bootstrap.php

    paths:
        - .

    excludePaths:
        - vendor
        - var
        - Tests
        - phpstan
        - phpstan-bootstrap.php
        - plugins/LeuchtfeuerDoiBundle/Tests
        - plugins/LeuchtfeuerDoiBundle/phpstan

    dynamicConstantNames:
        - MAUTIC_ENV
        - MAUTIC_TABLE_PREFIX
        - MAUTIC_VERSION
